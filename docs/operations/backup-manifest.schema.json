{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowos.example/schemas/backup-manifest-v1.json",
  "title": "FlowOS encrypted backup manifest",
  "description": "Schema only. Real manifests are encrypted operational artifacts and must never be committed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "backupId",
    "createdAt",
    "source",
    "release",
    "migrationLedger",
    "database",
    "storage",
    "integrity",
    "encryption",
    "operator",
    "providerKillSwitch",
    "validation"
  ],
  "properties": {
    "format": { "const": "flowos-backup-manifest" },
    "formatVersion": { "const": 1 },
    "backupId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,159}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "region"],
      "properties": {
        "projectId": { "type": "string", "minLength": 8, "maxLength": 80 },
        "region": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitCommit"],
      "properties": { "gitCommit": { "type": "string", "minLength": 7, "maxLength": 64 } }
    },
    "migrationLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versions", "fingerprintSha256"],
      "properties": {
        "versions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fingerprintSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "format", "sha256", "encrypted"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 8, "maxLength": 160 },
        "format": { "type": "string", "enum": ["logical-dump", "managed-backup-export"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "encrypted": { "const": true }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buckets", "objectCount", "objectsFingerprintSha256"],
      "properties": {
        "buckets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "isPrivate", "objectCount", "objects"],
            "properties": {
              "name": { "type": "string", "enum": ["company-documents", "company-images"] },
              "isPrivate": { "const": true },
              "objectCount": { "type": "integer", "minimum": 0 },
              "objects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "bytes", "sha256"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "bytes": { "type": "integer", "minimum": 0 },
                    "sha256": { "$ref": "#/$defs/sha256" }
                  }
                }
              }
            }
          }
        },
        "objectCount": { "type": "integer", "minimum": 0 },
        "objectsFingerprintSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotArtifactId", "snapshotSha256"],
      "properties": {
        "snapshotArtifactId": { "type": "string", "minLength": 8, "maxLength": 160 },
        "snapshotSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atRest", "algorithm", "keyReference"],
      "properties": {
        "atRest": { "const": true },
        "algorithm": { "type": "string", "minLength": 3, "maxLength": 80 },
        "keyReference": { "type": "string", "minLength": 3, "maxLength": 160 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": { "role": { "type": "string", "minLength": 2, "maxLength": 80 } }
    },
    "providerKillSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed", "aiMode"],
      "properties": {
        "confirmed": { "const": true },
        "aiMode": { "const": "mock" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "validated" } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  }
}
