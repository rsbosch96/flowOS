NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Pilot-safe default: mock AI never calls an external provider.
# AI_MODE=live requires a separate approved OpenAI provider release; setting it
# alone is never sufficient authorization.
AI_MODE=mock

# Disabled for the current pilot. Add only after the matching provider release
# gate has passed; use real values only in the environment's secret manager.
# OPENAI_API_KEY=
# OPENAI_QUOTE_MODEL=
# AI_PROVIDER=openai
# AI_MODEL_QUOTE=
# AI_MODEL_PRICING_JSON=
# AI_USD_EUR_RATE=
# AI_RC1_SPIKE_ENABLED=false
# AI_RC1_SPIKE_ID=
# AI_RC1_MAX_CALLS=5
# AI_RC1_MAX_OUTPUT_TOKENS=800
# AI_RC1_MAX_INPUT_BYTES=3600
# AI_RC1_SPIKE_BUDGET_CENTS=25

# Resend, Stripe, n8n webhooks and calendar providers are disabled. Each needs
# its own approved provider/OAuth release gate before its variables are set.
# RESEND_API_KEY=
# EMAIL_FROM=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# N8N_WEBHOOK_SECRET=
