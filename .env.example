NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
OPENAI_API_KEY=server-only-openai-key
OPENAI_QUOTE_MODEL=gpt-5.6-luna
AI_PROVIDER=openai
AI_MODEL_QUOTE=gpt-5.6-luna
AI_MODE=live
# Vul uitsluitend officieel geverifieerde providerprijzen in; ontbrekende tarieven geven NULL-kosten.
AI_MODEL_PRICING_JSON={"gpt-5.6-luna":{"inputUsdPerMillionTokens":1,"outputUsdPerMillionTokens":6}}
# Maandbudgetten staan in EUR. Vul een beheerde USD→EUR-koers in wanneer prijsdata in USD staat.
AI_USD_EUR_RATE=
AI_RC1_SPIKE_ENABLED=false
AI_RC1_SPIKE_ID=
AI_RC1_MAX_CALLS=5
AI_RC1_MAX_OUTPUT_TOKENS=800
AI_RC1_MAX_INPUT_BYTES=3600
AI_RC1_SPIKE_BUDGET_CENTS=25
STRIPE_SECRET_KEY=server-only-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_...
EMAIL_FROM=AI FlowOS <offertes@jouwdomein.nl>
